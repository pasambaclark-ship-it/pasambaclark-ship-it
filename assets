    <circle cx="838" cy="220" r="171" fill="none" stroke="#00f5a0" stroke-opacity=".16" stroke-dasharray="2 9"><animateTransform attributeName="transform" type="rotate" from="0 838 220" to="360 838 220" dur="38s" repeatCount="indefinite"/></circle>
    <circle cx="838" cy="220" r="184" fill="none" stroke="#55dfff" stroke-opacity=".22" stroke-dasharray="48 12 3 12"><animateTransform attributeName="transform" type="rotate" from="360 838 220" to="0 838 220" dur="54s" repeatCount="indefinite"/></circle>
    <circle cx="838" cy="220" r="201" fill="none" stroke="#b995ff" stroke-opacity=".12"><animate attributeName="r" values="190;207;190" dur="5s" repeatCount="indefinite"/></circle>
