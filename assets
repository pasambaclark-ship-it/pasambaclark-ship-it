    </g>
    <!-- Face / luminous scanning visor -->
    <path d="M767 210c14-34 39-55 71-55 32 0 58 21 72 55-10 32-37 50-72 50-34 0-60-18-71-50z" fill="#040c13" stroke="#00cfa5" stroke-opacity=".7" stroke-width="1.5"/>
    <path d="M776 208c21-13 42-19 62-19s41 6 62 19c-21 14-42 21-62 21s-41-7-62-21z" fill="url(#visor)" filter="url(#glow)"/>
    <path d="M785 208h107" stroke="#b9fff0" stroke-width="1" opacity=".85"><animate attributeName="opacity" values=".25;1;.25" dur="1.7s" repeatCount="indefinite"/></path>
    <circle cx="838" cy="207" r="3" fill="#fff" filter="url(#glow)"/>
