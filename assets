      <text x="1092" y="-30">0<tspan x="1092" dy="18">1</tspan><tspan x="1092" dy="18">1</tspan><tspan x="1092" dy="18">0</tspan><tspan x="1092" dy="18">1</tspan><animateTransform attributeName="transform" type="translate" values="0 0;0 460" dur="7s" repeatCount="indefinite"/></text>
    </g>
    <!-- Top terminal bar -->
    <path d="M0 52H1200" stroke="url(#neon)" stroke-opacity=".45"/>
    <circle cx="30" cy="27" r="6" fill="#ff5f57"/><circle cx="52" cy="27" r="6" fill="#febc2e"/><circle cx="74" cy="27" r="6" fill="#28c840"/>
    <text x="600" y="32" text-anchor="middle" fill="#7d9795" font-family="monospace" font-size="12" letter-spacing="2">CLARK@LEARNING-LAB : ~/CYBERSECURITY</text>
    <!-- Text panel -->
    <text x="68" y="117" fill="#00f5a0" font-family="monospace" font-size="15">$ whoami</text>
    <text x="68" y="165" fill="#effff8" font-family="monospace" font-size="29" font-weight="700">THE BINARY</text>
    <text x="68" y="202" fill="#effff8" font-family="monospace" font-size="29" font-weight="700">SENTINEL</text>
    <path d="M68 222H335" stroke="url(#neon)" stroke-width="2" opacity=".85"/>
    <text x="68" y="254" fill="#93aaa5" font-family="monospace" font-size="15">Student · Developer · Defender in training</text>
    <text x="68" y="291" fill="#00f5a0" font-family="monospace" font-size="14">&gt; code with purpose<tspan>_</tspan><animate attributeName="opacity" values="1;1;0;0;1" keyTimes="0;.72;.76;.91;1" dur="1.15s" repeatCount="indefinite"/></text>
    <text x="68" y="318" fill="#62d9ff" font-family="monospace" font-size="14">&gt; defend with knowledge</text>
    <text x="68" y="345" fill="#b995ff" font-family="monospace" font-size="14">&gt; learn without limits</text>
