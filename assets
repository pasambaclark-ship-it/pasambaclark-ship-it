    <rect x="0" y="0" width="1200" height="5" fill="url(#neon)" opacity=".5"><animate attributeName="y" values="55;430;55" dur="6s" repeatCount="indefinite"/></rect>
    <path d="M0 397H1200" stroke="#00f5a0" stroke-opacity=".24"/>
    <text x="55" y="423" fill="#718b87" font-family="monospace" font-size="11" letter-spacing="1">ETHICS: ON  /  CURIOSITY: HIGH  /  LEARNING: CONTINUOUS</text>
    <text x="1142" y="423" text-anchor="end" fill="#00f5a0" font-family="monospace" font-size="11">● SIGNAL SECURE</text>
  </g>
  <rect x="2" y="2" width="1196" height="436" rx="21" fill="none" stroke="url(#neon)" stroke-width="2" opacity=".82"/>
</svg>
