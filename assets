    <path d="M716 362c-22-54-25-118-12-172 12-52 45-91 92-107 48-17 103-6 136 30 31 34 41 86 31 143-7 41-22 77-41 106-18 17-54 27-103 27s-85-10-103-27z" fill="url(#hood)" stroke="#1ce9bb" stroke-width="2" stroke-opacity=".8"/>
