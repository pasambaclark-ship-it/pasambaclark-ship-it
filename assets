
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="440" viewBox="0 0 1200 440" role="img" aria-labelledby="title desc">
  <title id="title">Binary Sentinel — animated cybersecurity banner</title>
  <desc id="desc">A hooded digital sentinel formed from cascading binary, surrounded by neon code, a scanning visor, and security interface graphics.</desc>
  <defs>
    <linearGradient id="bg" x2="1" y2="1"><stop stop-color="#050a10"/><stop offset=".52" stop-color="#0a1720"/><stop offset="1" stop-color="#101022"/></linearGradient>
    <linearGradient id="neon"><stop stop-color="#00f5a0"/><stop offset=".53" stop-color="#38d9ff"/><stop offset="1" stop-color="#a978ff"/></linearGradient>
    <linearGradient id="hood" x2=".9" y2="1"><stop stop-color="#113d3d"/><stop offset=".5" stop-color="#08191f"/><stop offset="1" stop-color="#17132d"/></linearGradient>
    <linearGradient id="visor"><stop stop-color="#00f5a0" stop-opacity=".08"/><stop offset=".5" stop-color="#00f5a0" stop-opacity=".9"/><stop offset="1" stop-color="#00caff" stop-opacity=".12"/></linearGradient>
    <pattern id="grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#a3ffe0" stroke-opacity=".055"/></pattern>
    <filter id="glow"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <clipPath id="frame"><rect x="2" y="2" width="1196" height="436" rx="21"/></clipPath>
    <clipPath id="hoodClip"><path d="M716 362c-22-54-25-118-12-172 12-52 45-91 92-107 48-17 103-6 136 30 31 34 41 86 31 143-7 41-22 77-41 106-18 17-54 27-103 27s-85-10-103-27z"/></clipPath>
  </defs>
  <g clip-path="url(#frame)">
